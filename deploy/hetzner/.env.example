# Yuvomi on Hetzner - copied to .env by bootstrap.sh, which fills in the secrets.
# Never commit .env.

# Public host name. Its DNS A (and AAAA) record must point at the server
# before the first start, so Caddy can get the certificate.
DOMAIN=home.wojciechturek.com
BASE_URL=https://home.wojciechturek.com

# caddy = bundled HTTPS proxy on 80/443; empty = an existing web server
# proxies to 127.0.0.1:YUVOMI_LOCAL_PORT (bootstrap.sh decides).
COMPOSE_PROFILES=caddy
YUVOMI_LOCAL_PORT=3080

PORT=3000
TZ=Europe/Warsaw

# Generated by bootstrap.sh. KEEP A COPY OF DB_ENCRYPTION_KEY in your password
# manager: without it the database and every backup of it are unreadable.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
DB_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_ENCRYPTION_KEY

# Weather (Open-Meteo, no API key) - Kraków
WEATHER_LAT=50.0614
WEATHER_LON=19.9366
WEATHER_CITY=Kraków
WEATHER_UNITS=metric

# Web Push contact (Apple rejects pushes without a routable subject)
VAPID_SUBJECT=mailto:accounts@wojciechturek.com

# Login rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ATTEMPTS=5

# Backups: daily at 03:00 Warsaw time, keep 14 on the server
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_KEEP=14

# Off-site copy of each backup to a Hetzner Storage Box (recommended).
# Enable WebDAV on the Storage Box in the Hetzner console first.
# WEBDAV_BACKUP_ENABLED=true
# WEBDAV_BACKUP_URL=https://uXXXXXX.your-storagebox.de/
# WEBDAV_BACKUP_USERNAME=uXXXXXX
# WEBDAV_BACKUP_PASSWORD=
# WEBDAV_BACKUP_PATH=/yuvomi/backups/
# WEBDAV_BACKUP_KEEP=30

# iCloud calendar: easiest to connect in the app (Settings → Calendar sync → Apple Calendar),
# with an app-specific password from account.apple.com. Values here would
# override the UI.
# APPLE_CALDAV_URL=https://caldav.icloud.com
# APPLE_USERNAME=
# APPLE_APP_SPECIFIC_PASSWORD=
SYNC_INTERVAL_MINUTES=15

# Email (password reset, invitations). Optional; any SMTP provider works.
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=starttls
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# EMAIL_FROM_ADDRESS=accounts@wojciechturek.com
# EMAIL_FROM_NAME=Yuvomi

# Photo screensaver (needs an Immich server)
# IMMICH_URL=
# IMMICH_API_KEY=
# IMMICH_SCREENSAVER_ALBUM_ID=
